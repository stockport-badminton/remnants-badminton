---
// Opt-in panel for push notifications: which teams (one per competition) and
// which kinds (results, match-day reminders). Topics come from fixtures.json at
// build time; the server re-validates everything (netlify/functions/push-subscribe.mjs).
import fixtures from '../data/fixtures.json';
import push from '../data/push.json';
import { clubTopics } from '../lib/push/teams.mjs';

const topics = clubTopics(fixtures.fixtures);
const types = [
  { key: 'results', label: 'Results' },
  { key: 'reminders', label: 'Match-day reminders' },
];
---

<section
  id="push-panel"
  data-vapid-key={push.vapidPublicKey}
  class="mt-12 rounded-xl border border-gray-200 bg-gray-50 p-6"
  aria-labelledby="push-heading"
>
  <h2 id="push-heading" class="text-lg font-semibold text-primary mb-1">Notifications</h2>

  <!-- Exactly one [data-state] block is shown at a time -->
  <div data-state="loading"><p class="text-sm text-gray-500">Checking notification settings…</p></div>

  <div data-state="unsupported" hidden>
    <p class="text-sm text-gray-600">This browser doesn't support notifications.</p>
  </div>

  <div data-state="ios-install" hidden>
    <p class="text-sm text-gray-600">
      On iPhone and iPad, add this site to your Home Screen first: tap
      <strong>Share</strong> → <strong>Add to Home Screen</strong>, then open it from there to turn on notifications.
    </p>
  </div>

  <div data-state="dev" hidden>
    <p class="text-sm text-gray-600">Notifications only work on the live site (the service worker isn't registered in dev).</p>
  </div>

  <div data-state="denied" hidden>
    <p class="text-sm text-gray-600">
      Notifications are blocked for this site. To turn them on, allow notifications in your browser or phone settings, then reload.
    </p>
  </div>

  <div data-state="ready" hidden>
    <p data-role="intro" class="text-sm text-gray-600 mb-4"></p>
    <div class="grid sm:grid-cols-2 gap-4 mb-5">
      {topics.length > 1 && (
        <fieldset>
          <legend class="text-sm font-medium text-gray-700 mb-2">Teams</legend>
          <div class="flex flex-col gap-2">
            {topics.map((t) => (
              <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                <input type="checkbox" name="push-team" value={t.key} checked class="rounded border-gray-300" />
                {t.label}
              </label>
            ))}
          </div>
        </fieldset>
      )}
      <fieldset>
        <legend class="text-sm font-medium text-gray-700 mb-2">Notify me about</legend>
        <div class="flex flex-col gap-2">
          {types.map((t) => (
            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
              <input type="checkbox" name="push-type" value={t.key} checked class="rounded border-gray-300" />
              {t.label}
            </label>
          ))}
        </div>
      </fieldset>
    </div>
    <div class="flex flex-wrap gap-3">
      <button type="button" data-action="subscribe" class="bg-primary text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:opacity-90 disabled:opacity-50"></button>
      <button type="button" data-action="unsubscribe" hidden class="bg-white border border-gray-300 text-gray-700 text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-gray-100 disabled:opacity-50">Turn off</button>
    </div>
    <p data-role="status" class="text-sm mt-3" aria-live="polite"></p>
  </div>
</section>

<script>
  const API = '/.netlify/functions/push-subscribe';
  const STORAGE_KEY = 'push-prefs';
  const LEGACY_KEY = 'push-teams'; // teams-only prefs from before reminders existed

  type Prefs = { teams: string[]; types: string[] };

  const panel = document.getElementById('push-panel') as HTMLElement;
  const vapidKey = panel.dataset.vapidKey!;
  const $ = <T extends Element>(sel: string) => panel.querySelector(sel) as T;
  const boxes = (name: string) => [...panel.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`)];
  const subscribeBtn = $<HTMLButtonElement>('[data-action="subscribe"]');
  const unsubscribeBtn = $<HTMLButtonElement>('[data-action="unsubscribe"]');
  const intro = $<HTMLElement>('[data-role="intro"]');
  const status = $<HTMLElement>('[data-role="status"]');

  function show(state: string) {
    panel.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => (el.hidden = el.dataset.state !== state));
  }

  function setStatus(msg: string, error = false) {
    status.textContent = msg;
    status.className = `text-sm mt-3 ${error ? 'text-red-600' : 'text-green-700'}`;
  }

  // With a single team there are no team boxes; send [] which means "all teams".
  function selected(): Prefs {
    const checked = (name: string) => boxes(name).filter((b) => b.checked).map((b) => b.value);
    return { teams: checked('push-team'), types: checked('push-type') };
  }

  function restorePrefs() {
    let saved: Partial<Prefs> | null = null;
    try {
      saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      if (!saved) {
        const legacy = JSON.parse(localStorage.getItem(LEGACY_KEY) || 'null');
        if (legacy) saved = { teams: legacy };
      }
    } catch {}
    if (!saved) return;
    if (saved.teams?.length) boxes('push-team').forEach((b) => (b.checked = saved!.teams!.includes(b.value)));
    if (saved.types?.length) boxes('push-type').forEach((b) => (b.checked = saved!.types!.includes(b.value)));
  }

  function urlBase64ToUint8Array(base64: string) {
    const padded = (base64 + '='.repeat((4 - (base64.length % 4)) % 4)).replace(/-/g, '+').replace(/_/g, '/');
    return Uint8Array.from(atob(padded), (c) => c.charCodeAt(0));
  }

  function render(subscribed: boolean) {
    intro.textContent = subscribed
      ? `Notifications are on for this device. Change what you get below.`
      : `Get notifications on this device for results and on match days.`;
    subscribeBtn.textContent = subscribed ? 'Save settings' : 'Turn on notifications';
    unsubscribeBtn.hidden = !subscribed;
    show('ready');
  }

  async function save(sub: PushSubscription, prefs: Prefs) {
    const res = await fetch(API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ subscription: sub.toJSON(), ...prefs }),
    });
    if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || `HTTP ${res.status}`);
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
      localStorage.removeItem(LEGACY_KEY);
    } catch {}
  }

  async function init() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)) {
      const iOS = /iphone|ipad|ipod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;
      return show(iOS && !standalone ? 'ios-install' : 'unsupported');
    }
    if (Notification.permission === 'denied') return show('denied');

    const reg = await navigator.serviceWorker.getRegistration();
    if (!reg) return show(import.meta.env.DEV ? 'dev' : 'unsupported');

    restorePrefs();
    render(!!(await reg.pushManager.getSubscription()));

    subscribeBtn.addEventListener('click', async () => {
      const prefs = selected();
      if (boxes('push-team').length && !prefs.teams.length) return setStatus('Pick at least one team.', true);
      if (!prefs.types.length) return setStatus('Pick at least one kind of notification, or use Turn off.', true);
      subscribeBtn.disabled = true;
      try {
        const wasOn = !!(await reg.pushManager.getSubscription());
        if (Notification.permission !== 'granted' && (await Notification.requestPermission()) !== 'granted') {
          return show(Notification.permission === 'denied' ? 'denied' : 'ready');
        }
        const sub = (await reg.pushManager.getSubscription()) ??
          (await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: urlBase64ToUint8Array(vapidKey) }));
        await save(sub, prefs);
        render(true);
        setStatus(wasOn ? 'Settings saved.' : 'Notifications are on.');
      } catch (err) {
        setStatus(`Couldn't save notification settings: ${(err as Error).message}`, true);
      } finally {
        subscribeBtn.disabled = false;
      }
    });

    unsubscribeBtn.addEventListener('click', async () => {
      unsubscribeBtn.disabled = true;
      try {
        const sub = await reg.pushManager.getSubscription();
        if (sub) {
          await fetch(API, { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ endpoint: sub.endpoint }) }).catch(() => {});
          await sub.unsubscribe();
        }
        render(false);
        setStatus('Notifications are off.');
      } catch (err) {
        setStatus(`Couldn't turn off notifications: ${(err as Error).message}`, true);
      } finally {
        unsubscribeBtn.disabled = false;
      }
    });
  }

  init().catch((err) => { console.warn('push panel', err); show('unsupported'); });
</script>
